# msmtp — outgoing mail for both accounts (emacs-l88 / emacs-l7d).
# Same keyring secrets as mbsync; the app passwords cover SMTP too.

defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile ~/.local/state/msmtp/msmtp.log

account fastmail
host smtp.fastmail.com
port 465
tls_starttls off
from inbox@raymondmaung.com
user ray@raymondmaung.com
passwordeval "secret-tool lookup service mail account fastmail"

account gmail
host smtp.gmail.com
port 465
tls_starttls off
from ronokaoswe@gmail.com
user ronokaoswe@gmail.com
passwordeval "secret-tool lookup service mail account gmail"

account default : fastmail
