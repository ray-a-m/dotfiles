{
  "bar": {
    "centerAnchor": "",
    "layout": {
      "center": [
        {
          "id": "io.github.guiestrela.omarchy-google-calendar-clock",
          "format": "dddd M/d, h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "h\n\u2014\nmm\nAP"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "raymond.workspaces-numpad"
        }
      ],
      "right": [
        {
          "id": "raymond.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
