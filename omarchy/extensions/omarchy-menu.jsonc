{
  // Port of the pre-Quattro walker menu (menu.sh in this directory's git
  // history) to the Quattro Quickshell menu. Top level: Mail / Emacs /
  // Research / Files / Portals / System. Apps are not listed here because
  // SUPER+SPACE opens the app launcher directly.
  //
  // The stock root rows move to an unlisted parent, which no submenu
  // displays. A `when: "false"` guard would also break their routes and the
  // apps provider ("Nothing here yet"), so re-parenting is the correct hide.
  // Routes (`omarchy menu summon <name>`), links, and search still reach
  // them.
  //
  // Each override restates the stock fields: the loader normalizes a user
  // entry (missing fields become empty) before the merge, so a sparse
  // override would erase the stock icon, label, aliases, and provider.
  "apps": {"parent": "unlisted", "icon": "󰀻", "label": "Apps", "aliases": ["app", "applications"], "provider": "apps"},
  "learn": {"parent": "unlisted", "icon": "󰧑", "label": "Learn"},
  "trigger": {"parent": "unlisted", "icon": "󱓞", "label": "Trigger"},
  "style": {"parent": "unlisted", "icon": "", "label": "Style"},
  "setup": {"parent": "unlisted", "icon": "", "label": "Setup", "aliases": ["settings"]},
  "install": {"parent": "unlisted", "icon": "󰉉", "label": "Install"},
  "remove": {"parent": "unlisted", "icon": "󰭌", "label": "Remove", "aliases": ["uninstall"]},
  "update": {"parent": "unlisted", "icon": "", "label": "Update", "aliases": ["restart", "refresh"]},
  "about": {"parent": "unlisted", "icon": "", "label": "About", "action": "omarchy-launch-about"},
  "system": {"parent": "unlisted", "icon": "", "label": "System", "aliases": ["power-menu"]},

  // No GUI path to logout: a logout drops to the white SDDM greeter. The
  // stock system submenu stays routable, so hide its logout row too.
  "system.logout": {"icon": "󰍃", "label": "Logout", "action": "omarchy-system-logout", "when": "false"},

  // Custom root menu
  "mail": {"icon": "󰇮", "label": "Mail"},
  "mail.personal": {"icon": "", "label": "Personal", "action": "gtk-launch personal-gmail"},
  "mail.professional": {"icon": "", "label": "Professional", "action": "gtk-launch fastmail"},
  "mail.uic": {"icon": "", "label": "UIC", "action": "gtk-launch uic-email"},

  "emacs": {"icon": "", "label": "Emacs", "action": "gtk-launch emacsclient"},

  "research": {"icon": "󰂺", "label": "Research"},
  "research.chatgpt": {"icon": "", "label": "ChatGPT", "action": "gtk-launch chatgpt"},
  "research.claude": {"icon": "", "label": "Claude", "action": "gtk-launch claude"},
  "research.library": {"icon": "", "label": "UIC Library", "action": "gtk-launch uic-library"},
  "research.zotero": {"icon": "", "label": "Zotero", "action": "gtk-launch zotero"},

  "files": {"icon": "󰉋", "label": "Files"},
  "files.personal": {"icon": "", "label": "Personal", "action": "gtk-launch personal-gdrive"},
  "files.uic": {"icon": "", "label": "UIC", "action": "gtk-launch uic-gdrive"},

  "portals": {"icon": "󰖟", "label": "Portals"},
  "portals.canvas": {"icon": "", "label": "Canvas", "action": "gtk-launch canvas"},
  "portals.github": {"icon": "", "label": "GitHub", "action": "gtk-launch github"},

  // Self-hosted services (homelab). URLs live in the launchers in
  // dotfiles-private/applications/ (this repo is public); they open over the
  // mesh VPN, so they work away from home while the mesh client runs.
  // No submenu: Homepage is the landing surface for every service,
  // Proxmox included, so Server opens it directly.
  "server": {"icon": "󰒋", "label": "Server", "action": "gtk-launch server-homepage"},

  // System, rebuilt under its own id ("power") for full control of row order.
  // Logout is omitted on purpose: securing this machine means Lock, and a
  // logout drops to the white SDDM greeter (rationale in menu.sh, git
  // history). The rare intentional logout stays available as `omarchy logout`
  // in a terminal.
  "power": {"icon": "", "label": "System"},
  "power.style": {"icon": "", "label": "Style", "target": "style"},

  // Video wallpapers for the current theme, one row per file in
  // dotfiles-private/omarchy/backgrounds/<theme>/ (Git LFS). The stock
  // Style > Background picker is image-only, so this is the only GUI path
  // to a video. Each row calls omarchy-bg-video-set (omarchy/bin/), which
  // records the choice, sets the matching still as the lock-screen image,
  // and re-fires the theme-set hook. The ✓ marks the recorded choice. A
  // new video = drop the file (plus its -static still) in the backgrounds
  // dir and add a row here.
  //
  // Live / Still pick whether the chosen video plays (mpvpaper) or its
  // still frame is the wallpaper. The mode is a per-machine toggle
  // (toggles/video-wallpaper-off), so a laptop that cannot afford the
  // decoder keeps the same pictures without the videos being touched.
  "power.wallpaper": {"icon": "", "label": "Wallpaper", "aliases": ["video", "background"]},
  "power.wallpaper.live": {"icon": "", "label": "Live", "checked": "! omarchy-toggle-enabled video-wallpaper-off", "action": "omarchy-bg-video-set --live"},
  "power.wallpaper.still": {"icon": "", "label": "Still", "checked": "omarchy-toggle-enabled video-wallpaper-off", "action": "omarchy-bg-video-set --still"},
  "power.wallpaper.mornye": {"icon": "", "label": "Mornye", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */mornye.* ]]", "action": "omarchy-bg-video-set mornye"},
  "power.wallpaper.beyond-the-rolling-hills": {"icon": "", "label": "Beyond the Rolling Hills", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */beyond-the-rolling-hills.* ]]", "action": "omarchy-bg-video-set beyond-the-rolling-hills"},
  "power.wallpaper.genshin-impact-landscape": {"icon": "", "label": "Genshin Impact Landscape", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */genshin-impact-landscape.* ]]", "action": "omarchy-bg-video-set genshin-impact-landscape"},
  "power.wallpaper.green-meadow-under-blue-sky": {"icon": "", "label": "Green Meadow Under Blue Sky", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */green-meadow-under-blue-sky.* ]]", "action": "omarchy-bg-video-set green-meadow-under-blue-sky"},
  "power.wallpaper.green-tree": {"icon": "", "label": "Green Tree", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */green-tree.* ]]", "action": "omarchy-bg-video-set green-tree"},
  "power.wallpaper.palm-arch-paradise": {"icon": "", "label": "Palm Arch Paradise", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */palm-arch-paradise.* ]]", "action": "omarchy-bg-video-set palm-arch-paradise"},
  "power.wallpaper.sunlight-bamboos": {"icon": "", "label": "Sunlight Bamboos", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */sunlight-bamboos.* ]]", "action": "omarchy-bg-video-set sunlight-bamboos"},
  "power.wallpaper.zen-bamboo-forest": {"icon": "", "label": "Zen Bamboo Forest", "checked": "[[ $(readlink \"$HOME/.local/state/omarchy/current/background-video\") == */zen-bamboo-forest.* ]]", "action": "omarchy-bg-video-set zen-bamboo-forest"},
  "power.screensaver": {"icon": "󱄄", "label": "Screensaver", "action": "omarchy-launch-screensaver force"},
  "power.lock": {"icon": "", "label": "Lock", "action": "omarchy-system-lock"},
  "power.suspend": {"icon": "󰒲", "label": "Suspend", "when": "! omarchy-toggle-enabled suspend-off", "action": "systemctl suspend"},
  "power.hibernate": {"icon": "󰤁", "label": "Hibernate", "when": "omarchy-hibernation-available", "action": "systemctl hibernate"},

  // Restart and Shutdown open a confirm submenu with Cancel first, so a
  // stray Enter or `l` cannot power the machine off.
  "power.restart": {"icon": "󰜉", "label": "Restart"},
  "power.restart.cancel": {"icon": "", "label": "Cancel", "target": "power"},
  "power.restart.yes": {"icon": "󰜉", "label": "Yes", "action": "omarchy-system-reboot"},
  "power.shutdown": {"icon": "󰐥", "label": "Shutdown"},
  "power.shutdown.cancel": {"icon": "", "label": "Cancel", "target": "power"},
  "power.shutdown.yes": {"icon": "󰐥", "label": "Yes", "action": "omarchy-system-shutdown"}
}
