#!/bin/bash
# Post-update hook: omarchy migrations occasionally call
# `omarchy-restart-waybar`, which does `pkill && setsid uwsm-app -- waybar`
# directly — that path bypasses the autostart `waybar-off` toggle check
# (~/.local/state/omarchy/toggles/waybar-off), so an `omarchy update` can
# spawn waybar even though we've disabled it. Kill it again here. The hook
# is a no-op when waybar isn't running.
#
# Triggered by Hyprland's post-boot exec-once line in
# ~/.local/share/omarchy/default/hypr/autostart.conf, and also runs at
# the tail of an `omarchy update` via the same omarchy-hook plumbing.

pkill -x waybar 2>/dev/null

exit 0
