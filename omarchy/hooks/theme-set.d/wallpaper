#!/bin/bash
# Wallpaper daemon manager, dual-era so it works on both sides of the
# Omarchy 3→4 (Quattro) upgrade.
#
# Pre-Quattro: omarchy's bg-next always launches swaybg, which silently
# fails on video files — swap swaybg ↔ mpvpaper by extension.
#
# Quattro: the omarchy-shell background plugin renders images itself (its
# picker never links a video), so this hook only manages mpvpaper for
# video wallpapers. mpvpaper is spawned fresh each time so its surface
# lands ABOVE the shell's static background layer — which stays underneath
# as fallback art and as the lock-screen image.

STATE_BG="$HOME/.local/state/omarchy/current/background"
LEGACY_BG="$HOME/.config/omarchy/current/background"

# Kill by exact name and wait until it's actually gone (up to ~3s).
kill_and_wait() {
  local name=$1
  for _ in $(seq 1 30); do
    pgrep -x "$name" >/dev/null || return 0
    pkill -x "$name" 2>/dev/null
    sleep 0.1
  done
}

# Reap any swaybg for the next N seconds (pre-Quattro only). Guards both
# directions of the login race: upstream autostart may spawn swaybg
# *before* or *after* this hook fires, and either way swaybg's empty
# surface ends up on top of mpvpaper.
reap_swaybg_window() {
  local seconds=${1:-8}
  ( for _ in $(seq 1 $((seconds * 10))); do
      pkill -x swaybg 2>/dev/null
      sleep 0.1
    done ) >/dev/null 2>&1 &
  disown
}

spawn_mpvpaper() {
  kill_and_wait mpvpaper
  setsid uwsm-app -- mpvpaper -f -o "no-audio loop hwdec=auto panscan=1.0 speed=0.5" '*' "$1" >/dev/null 2>&1 &
}

is_video() {
  case "${1##*.}" in
    mp4|MP4|webm|WEBM|mkv|MKV|mov|MOV|avi|AVI) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ -e $LEGACY_BG || -L $LEGACY_BG ]]; then
  # --- Pre-Quattro path (unchanged behavior) -------------------------------
  CURRENT_BG=$(readlink -f "$LEGACY_BG" 2>/dev/null)
  [[ -z $CURRENT_BG || ! -e $CURRENT_BG ]] && exit 0

  if is_video "$CURRENT_BG"; then
    kill_and_wait swaybg
    reap_swaybg_window 8
    spawn_mpvpaper "$CURRENT_BG"
  elif pgrep -x mpvpaper >/dev/null; then
    kill_and_wait mpvpaper
    kill_and_wait swaybg
    setsid uwsm-app -- swaybg -i "$CURRENT_BG" -m fill >/dev/null 2>&1 &
  fi
else
  # --- Quattro path --------------------------------------------------------
  # Still mode (per-machine, ~/.local/state/omarchy/toggles/video-wallpaper-off,
  # set by `omarchy-bg-video-set --still` = System > Wallpaper > Still): no
  # mpvpaper at all. The shell keeps painting the chosen video's still, which
  # omarchy-bg-video-set already set as current/background. A machine that
  # cannot afford a decoding mpv gets the same wallpapers as pictures.
  if omarchy-toggle-enabled video-wallpaper-off; then
    kill_and_wait mpvpaper
    exit 0
  fi

  # The current/background link only ever points at an image. Video
  # wallpapers live in the theme's user backgrounds dir, invisible to the
  # shell's image-only picker — find them there. Which one plays:
  #   1. the video recorded in current/background-video (written by
  #      omarchy-bg-video-set, the System > Wallpaper menu), when it is one
  #      of this theme's videos — a choice made under another theme is
  #      ignored, and a theme with no videos kills mpvpaper as before;
  #   2. else the video named after the theme (mornye.mp4 for mornye), so
  #      a fresh machine plays the theme's own wallpaper, not whichever
  #      file sorts first;
  #   3. else the first video by name.
  # A recorded choice that is one of this theme's plain images (a
  # still-only wallpaper such as bliss.jpg, not a video's -static frame)
  # means no video at all: omarchy-bg-video-set already set it as the
  # shell's image, so kill mpvpaper and let the shell paint it.
  THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
  VIDEO=""
  if [[ -n $THEME_NAME ]]; then
    CHOSEN=$(readlink -f "$HOME/.local/state/omarchy/current/background-video" 2>/dev/null)
    if [[ -n $CHOSEN && -f $CHOSEN ]] && ! is_video "$CHOSEN"; then
      while IFS= read -r s; do
        if [[ $(readlink -f "$s") == "$CHOSEN" ]]; then
          kill_and_wait mpvpaper
          exit 0
        fi
      done < <(find -L "$HOME/.config/omarchy/backgrounds/$THEME_NAME/" \
        "$HOME/.local/state/omarchy/current/theme/backgrounds/" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        ! -name '*-static.*' 2>/dev/null)
    fi
    mapfile -t VIDEOS < <(find -L "$HOME/.config/omarchy/backgrounds/$THEME_NAME/" \
      "$HOME/.local/state/omarchy/current/theme/backgrounds/" -maxdepth 1 -type f \
      \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.avi' \) \
      2>/dev/null | sort)
    for v in "${VIDEOS[@]}"; do
      if [[ -n $CHOSEN && $(readlink -f "$v") == "$CHOSEN" ]]; then VIDEO=$v; break; fi
    done
    if [[ -z $VIDEO ]]; then
      for v in "${VIDEOS[@]}"; do
        b=$(basename "$v")
        if [[ ${b%.*} == "$THEME_NAME" ]]; then VIDEO=$v; break; fi
      done
    fi
    [[ -z $VIDEO && ${#VIDEOS[@]} -gt 0 ]] && VIDEO=${VIDEOS[0]}
  fi

  if [[ -n $VIDEO ]]; then
    spawn_mpvpaper "$VIDEO"
  else
    kill_and_wait mpvpaper
  fi
fi
exit 0
