#!/usr/bin/env bash
# Re-enable USB power/wakeup on resume from s2idle. Direct sysfs write
# instead of `udevadm trigger` for the same reason as the boot service:
# we observed the udev path silently failing to apply on this box.
case "$1" in
  post)
    for f in /sys/bus/usb/devices/*/power/wakeup; do
      [ -w "$f" ] && echo enabled > "$f"
    done 2>/dev/null
    ;;
esac
