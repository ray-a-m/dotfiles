# Fetch mail from Fastmail (emacs-l7d; one account since emacs-v6o). The
# timer drives this every ~5 minutes; mu4e's U key triggers the same
# unit, so every fetch error lands in one journal: journalctl --user -u mbsync.

[Unit]
Description=Sync mail with mbsync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mbsync -a
# Re-index after the fetch, or mu's index (what mu4e reads) falls
# behind the maildir. Lazy: only directories whose
# timestamps changed. The leading dash tolerates the one expected
# failure: a running mu4e server holds the store, and indexes on its own.
ExecStartPost=-/usr/bin/mu index --lazy-check --quiet
