[Unit]
Description=Force USB power/wakeup=enabled across hubs and HID devices
# The udev-rule + udevadm-trigger approach didn't stick at boot — wakeup
# state remained disabled even after `systemctl status` confirmed the unit
# ran successfully after multi-user.target. Either udev's writes don't
# take that early in boot, or something resets them right after.
#
# Direct sysfs write at this stage works (manual tests confirm). We run
# late, after user-sessions, when any earlier power-management daemon has
# already finished its initial pass.
After=multi-user.target systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for f in /sys/bus/usb/devices/*/power/wakeup; do [ -w "$f" ] && echo enabled > "$f"; done 2>/dev/null'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
