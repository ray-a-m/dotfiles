\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maungbody}[2026/07/03 v0.1 Raymond Maung body-facing vocabulary]

% Everything paper/chapter *bodies* rely on to compile and mean the same
% thing under any driver: standalone papers load this via maungstyle; the
% dissertation preamble loads it directly (its look is the Ross accessible
% template, not maungstyle's). Look-and-feel belongs in maungstyle.

% ── Text ──────────────────────────────────────────────────────────────────────
\RequirePackage{csquotes}

% ── Math ──────────────────────────────────────────────────────────────────────
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{esint}
\RequirePackage{bm}
\RequirePackage{nicefrac}
\RequirePackage{physics2}
\usephysicsmodule{braket}

% amssymb's \mathbb -- and libertinust1math's, which overrides it under the
% maungstyle (paper) look -- has no double-struck DIGIT glyphs, so \mathbb{1},
% the identity operator, renders as a missing character. Route just the digit 1
% to dsfont's double-struck \mathds{1}; letters keep their blackboard face.
% Deferred to \AtEndPreamble so it patches whichever \mathbb is active after
% every font package has loaded (libertinust1math in papers, amssymb in the
% dissertation), and runs before the begin-document math finalization that an
% \AtBeginDocument patch collides with (\mathbb allowed only in math mode).
\RequirePackage{dsfont}
\RequirePackage{etoolbox}
\AtEndPreamble{%
  \let\maung@orig@mathbb\mathbb
  \renewcommand{\mathbb}[1]{{%
    \def\maung@mathbb@arg{#1}\def\maung@mathbb@one{1}%
    \ifx\maung@mathbb@arg\maung@mathbb@one \mathds{1}\else\maung@orig@mathbb{#1}\fi}}%
}

% ── Figures ───────────────────────────────────────────────────────────────────
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{subcaption}

\captionsetup{labelsep=period}

% ── Tables ────────────────────────────────────────────────────────────────────
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{multirow}

\renewcommand{\arraystretch}{1.1}

% ── Commands ──────────────────────────────────────────────────────────────────

% Latin abbreviations (\@ handles end-of-sentence period spacing)
\def\cf{\emph{cf.}\@}
\def\eg{\emph{e.g.}\@}
\def\ie{\emph{i.e.}\@}
\def\etc{\emph{etc.}\@}
\def\etal{\emph{et al.}\@}
\def\viz{\emph{viz.}\@}
\def\sc{\emph{sc.}\@}

% Auto-sizing paired delimiters (use e.g. \abs{x} fixed, \abs*{\frac{a}{b}} auto-sized)
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\DeclarePairedDelimiter\ceil{\lceil}{\rceil}
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor}

% Math operators
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\diag}{diag}

\endinput
