# /etc/pacman.d/hooks/firefox-userchrome.hook
#
# Pacman wipes /usr/lib/firefox/ on each `firefox` package install or
# upgrade, which removes the chrome-toggle bootstrap files (autoconfig.js
# and firefox.cfg). This hook redeploys them from the dotfiles tree
# immediately after the transaction commits, so the next Firefox launch
# picks them up.
#
# Stable assumption: the dotfiles path is hardcoded to
# /home/raymond/code/dotfiles. Pacman hooks run as root with a minimal
# environment, so we can't expand $HOME or look up the invoking user.
# If the dotfiles location ever changes, this file needs updating too.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = firefox

[Action]
Description = Redeploy Firefox chrome-toggle bootstrap from dotfiles
When = PostTransaction
Exec = /bin/sh -c "cp /home/raymond/code/dotfiles/firefox/autoconfig.js /usr/lib/firefox/defaults/pref/autoconfig.js && cp /home/raymond/code/dotfiles/firefox/firefox.cfg /usr/lib/firefox/firefox.cfg"
